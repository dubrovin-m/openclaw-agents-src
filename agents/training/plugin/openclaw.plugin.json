{
  "id": "training",
  "name": "Training",
  "description": "Owner-scoped deterministic Training Store and session execution tools.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": [
      "databasePath"
    ],
    "properties": {
      "databasePath": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/"
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "training_status",
      "training_recommendation_get",
      "training_session_get",
      "training_session_start",
      "training_progression_get",
      "training_session_start_ad_hoc",
      "training_conditioning_get",
      "training_conditioning_prescribe",
      "training_conditioning_complete",
      "training_exercise_prescribe",
      "training_exercise_complete",
      "training_exercise_defer",
      "training_exercise_resume",
      "training_exercise_skip",
      "training_session_pause",
      "training_session_resume",
      "training_session_abandon",
      "training_session_finish",
      "training_set_correct",
      "training_feedback_record",
      "training_observation_record",
      "training_learning_get",
      "training_learning_upsert",
      "training_program_change_propose",
      "training_program_change_apply",
      "training_session_void"
    ]
  },
  "toolMetadata": {
    "training_status": {
      "optional": true
    },
    "training_recommendation_get": {
      "optional": true
    },
    "training_session_get": {
      "optional": true
    },
    "training_session_start": {
      "optional": true
    },
    "training_progression_get": {
      "optional": true
    },
    "training_session_start_ad_hoc": {
      "optional": true
    },
    "training_conditioning_get": {
      "optional": true
    },
    "training_conditioning_prescribe": {
      "optional": true
    },
    "training_conditioning_complete": {
      "optional": true
    },
    "training_exercise_prescribe": {
      "optional": true
    },
    "training_exercise_complete": {
      "optional": true
    },
    "training_exercise_defer": {
      "optional": true
    },
    "training_exercise_resume": {
      "optional": true
    },
    "training_exercise_skip": {
      "optional": true
    },
    "training_session_pause": {
      "optional": true
    },
    "training_session_resume": {
      "optional": true
    },
    "training_session_abandon": {
      "optional": true
    },
    "training_session_finish": {
      "optional": true
    },
    "training_set_correct": {
      "optional": true
    },
    "training_feedback_record": {
      "optional": true
    },
    "training_observation_record": {
      "optional": true
    },
    "training_learning_get": {
      "optional": true
    },
    "training_learning_upsert": {
      "optional": true
    },
    "training_program_change_propose": {
      "optional": true
    },
    "training_program_change_apply": {
      "optional": true
    },
    "training_session_void": {
      "optional": true
    }
  }
}
