{
  "id": "training",
  "name": "Training",
  "description": "Owner-scoped deterministic Training Store and session execution tools.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": ["databasePath"],
    "properties": {
      "databasePath": {"type":"string","minLength":1,"pattern":"^/"}
    },
    "additionalProperties": false
  },
  "activation": {"onStartup": true},
  "contracts": {
    "tools": [
      "training_status",
      "training_recommendation_get",
      "training_session_get",
      "training_session_start",
      "training_exercise_prescribe",
      "training_exercise_complete",
      "training_exercise_defer",
      "training_exercise_skip",
      "training_session_finish",
      "training_session_void"
    ]
  },
  "toolMetadata": {
    "training_status": {"optional": true},
    "training_recommendation_get": {"optional": true},
    "training_session_get": {"optional": true},
    "training_session_start": {"optional": true},
    "training_exercise_prescribe": {"optional": true},
    "training_exercise_complete": {"optional": true},
    "training_exercise_defer": {"optional": true},
    "training_exercise_skip": {"optional": true},
    "training_session_finish": {"optional": true},
    "training_session_void": {"optional": true}
  }
}
