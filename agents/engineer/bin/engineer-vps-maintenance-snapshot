#!/usr/bin/env python3
"""Deterministic read-only evidence collector for scheduled Engineer VPS maintenance."""
from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

SCHEMA_VERSION = 1
COLLECTOR_VERSION = "1.1.0"
AGENT_OUTPUT_MAX_BYTES = 18000
AGENT_LIST_LIMIT = 40
HOME = Path.home()
NEXUS = HOME / ".openclaw" / "workspace" / "nexus"
STATE_DB = HOME / ".openclaw" / "state" / "openclaw.sqlite"
MAX_OUTPUT = 24000

SECRET_PATTERNS = [
    (re.compile(r"\b(?:sk|ghp|github_pat)_[A-Za-z0-9_-]{12,}\b"), "<redacted-token>"),
    (re.compile(r"(?i)\b(bearer|authorization|token|api[_-]?key|password)\s*[:=]\s*\S+"), r"\1=<redacted>"),
    (re.compile(r"\b\d{6,}:[A-Za-z0-9_-]{20,}\b"), "<redacted-bot-token>"),
]


def redact(text: str) -> str:
    value = text
    for pattern, replacement in SECRET_PATTERNS:
        value = pattern.sub(replacement, value)
    return value


def bounded(text: str, limit: int = MAX_OUTPUT) -> str:
    value = redact(text)
    if len(value) <= limit:
        return value
    return value[:limit] + f"\n<truncated {len(value) - limit} chars>"


def run(argv: list[str], timeout: int = 20, ok_codes: tuple[int, ...] = (0,), max_output: int = MAX_OUTPUT) -> dict:
    executable = shutil.which(argv[0])
    if executable is None:
        return {"available": False, "argv": argv, "error": "executable-not-found"}
    env = os.environ.copy()
    uid = os.getuid()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")
    started = time.monotonic()
    try:
        proc = subprocess.run(
            [executable, *argv[1:]],
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        return {
            "available": True,
            "argv": argv,
            "timed_out": True,
            "duration_ms": round((time.monotonic() - started) * 1000),
            "stdout": bounded(exc.stdout or "", max_output),
            "stderr": bounded(exc.stderr or "", max_output),
        }
    return {
        "available": True,
        "argv": argv,
        "exit_code": proc.returncode,
        "ok": proc.returncode in ok_codes,
        "duration_ms": round((time.monotonic() - started) * 1000),
        "stdout": bounded(proc.stdout, max_output),
        "stderr": bounded(proc.stderr, max_output),
    }


def read_text(path: Path, max_bytes: int = 300_000) -> str | None:
    try:
        with path.open("rb") as handle:
            data = handle.read(max_bytes + 1)
        if len(data) > max_bytes:
            return None
        return data.decode("utf-8", errors="replace")
    except OSError:
        return None


def sha256_file(path: Path) -> str | None:
    try:
        digest = hashlib.sha256()
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
        return digest.hexdigest()
    except OSError:
        return None


def extract_markdown_section(path: Path, heading: str) -> str | None:
    text = read_text(path)
    if text is None:
        return None
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if line.strip() == heading)
    except StopIteration:
        return None
    level = len(heading) - len(heading.lstrip("#"))
    end = len(lines)
    for i in range(start + 1, len(lines)):
        line = lines[i]
        if line.startswith("#"):
            next_level = len(line) - len(line.lstrip("#"))
            if next_level <= level:
                end = i
                break
    return bounded("\n".join(lines[start:end]), 12000)


def repo_head_without_git(repo: Path) -> str | None:
    git = repo / ".git"
    if git.is_file():
        marker = read_text(git, 4096)
        if not marker or not marker.startswith("gitdir:"):
            return None
        git = (repo / marker.split(":", 1)[1].strip()).resolve()
    head = read_text(git / "HEAD", 4096)
    if not head:
        return None
    head = head.strip()
    if not head.startswith("ref: "):
        return head if re.fullmatch(r"[0-9a-f]{40}", head) else None
    ref = head[5:]
    loose = read_text(git / ref, 4096)
    if loose and re.fullmatch(r"[0-9a-f]{40}", loose.strip()):
        return loose.strip()
    packed = read_text(git / "packed-refs", 2_000_000) or ""
    for line in packed.splitlines():
        if line.startswith("#") or line.startswith("^"):
            continue
        parts = line.split(" ", 1)
        if len(parts) == 2 and parts[1] == ref and re.fullmatch(r"[0-9a-f]{40}", parts[0]):
            return parts[0]
    return None


def meminfo() -> dict:
    result: dict[str, int] = {}
    text = read_text(Path("/proc/meminfo"), 100_000) or ""
    for line in text.splitlines():
        if ":" not in line:
            continue
        key, raw = line.split(":", 1)
        match = re.search(r"(\d+)", raw)
        if match:
            result[key] = int(match.group(1)) * 1024
    return result


def filesystem(path: Path) -> dict:
    try:
        stat = os.statvfs(path)
        return {
            "path": str(path),
            "bytes_total": stat.f_frsize * stat.f_blocks,
            "bytes_available": stat.f_frsize * stat.f_bavail,
            "bytes_used": stat.f_frsize * (stat.f_blocks - stat.f_bfree),
            "inodes_total": stat.f_files,
            "inodes_available": stat.f_favail,
            "inodes_used": stat.f_files - stat.f_ffree,
        }
    except OSError as exc:
        return {"path": str(path), "error": type(exc).__name__}


def dir_stats(path: Path, older_than_days: int | None = None) -> dict:
    now = time.time()
    count = 0
    total = 0
    errors = 0
    try:
        for root, dirs, files in os.walk(path, topdown=True, followlinks=False):
            dirs[:] = [d for d in dirs if not Path(root, d).is_symlink()]
            for name in files:
                candidate = Path(root, name)
                try:
                    st = candidate.lstat()
                    if not candidate.is_file() or candidate.is_symlink():
                        continue
                    if older_than_days is not None and now - st.st_mtime < older_than_days * 86400:
                        continue
                    count += 1
                    total += st.st_size
                except OSError:
                    errors += 1
    except OSError:
        errors += 1
    return {"path": str(path), "file_count": count, "bytes": total, "errors": errors, "older_than_days": older_than_days}


def http_json(url: str, timeout: int = 12) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": "engineer-vps-maintenance-snapshot/1.0"})
    started = time.monotonic()
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read(1_500_000)
        return {"ok": True, "duration_ms": round((time.monotonic() - started) * 1000), "value": json.loads(raw)}
    except Exception as exc:
        return {"ok": False, "duration_ms": round((time.monotonic() - started) * 1000), "error": f"{type(exc).__name__}: {exc}"}


def official_release_evidence() -> dict:
    result: dict = {}
    releases = http_json("https://api.github.com/repos/openclaw/openclaw/releases?per_page=5")
    if releases.get("ok") and isinstance(releases.get("value"), list):
        stable = next((item for item in releases["value"] if not item.get("draft") and not item.get("prerelease")), None)
        if stable:
            result["openclaw_latest_stable"] = {
                "tag": stable.get("tag_name"),
                "name": stable.get("name"),
                "published_at": stable.get("published_at"),
                "updated_at": stable.get("updated_at"),
                "html_url": stable.get("html_url"),
                "release_notes": bounded(stable.get("body") or "", 10000),
            }
    else:
        result["openclaw_error"] = releases.get("error")
    node = http_json("https://nodejs.org/dist/index.json")
    if node.get("ok") and isinstance(node.get("value"), list):
        rows = node["value"][:20]
        latest = rows[0] if rows else None
        latest_lts = next((item for item in rows if item.get("lts")), None)
        result["node_latest"] = latest
        result["node_latest_lts"] = latest_lts
    else:
        result["node_error"] = node.get("error")
    public_impl = http_json("https://api.github.com/repos/dubrovin-m/openclaw-agents-src/commits/main")
    if public_impl.get("ok") and isinstance(public_impl.get("value"), dict):
        result["openclaw_agents_src_main"] = public_impl["value"].get("sha")
    else:
        result["openclaw_agents_src_error"] = public_impl.get("error")
    runtime_contract = http_json("https://raw.githubusercontent.com/dubrovin-m/openclaw-agents-src/main/runtime-contract.json")
    if runtime_contract.get("ok") and isinstance(runtime_contract.get("value"), dict):
        result["openclaw_agents_runtime_contract"] = runtime_contract["value"]
    else:
        result["openclaw_agents_runtime_contract_error"] = runtime_contract.get("error")
    taskctl = http_json("https://raw.githubusercontent.com/dubrovin-m/openclaw-agents-src/main/agents/tasks/plugins/taskctl/package.json")
    if taskctl.get("ok") and isinstance(taskctl.get("value"), dict):
        value = taskctl["value"]
        result["taskctl_compatibility"] = {
            "version": value.get("version"),
            "engines": value.get("engines"),
            "peerDependencies": value.get("peerDependencies"),
            "devDependencies": value.get("devDependencies"),
        }
    else:
        result["taskctl_compatibility_error"] = taskctl.get("error")
    return result



def global_npm_inventory() -> dict:
    """Read installed global package metadata directly and query registry without npm CLI/cache writes."""
    root = HOME / ".npm-global" / "lib" / "node_modules"
    packages: list[dict] = []
    if not root.exists():
        return {"root": str(root), "packages": packages, "error": "global-node-modules-not-found"}
    candidates: list[Path] = []
    for child in sorted(root.iterdir(), key=lambda item: item.name):
        if child.name.startswith("@") and child.is_dir():
            candidates.extend(sorted((item for item in child.iterdir() if item.is_dir()), key=lambda item: item.name))
        elif child.is_dir():
            candidates.append(child)
    for package_dir in candidates:
        raw = read_text(package_dir / "package.json", 500_000)
        if raw is None:
            continue
        try:
            metadata = json.loads(raw)
        except json.JSONDecodeError:
            continue
        name = metadata.get("name")
        version = metadata.get("version")
        if not isinstance(name, str) or not name or not isinstance(version, str):
            continue
        encoded = urllib.parse.quote(name, safe="@")
        latest = http_json(f"https://registry.npmjs.org/{encoded}/latest")
        latest_version = None
        if latest.get("ok") and isinstance(latest.get("value"), dict):
            latest_version = latest["value"].get("version")
        packages.append({
            "name": name,
            "installed": version,
            "latest": latest_version,
            "registry_ok": bool(latest.get("ok")),
            "registry_error": None if latest.get("ok") else latest.get("error"),
        })
    return {"root": str(root), "packages": packages}

def custom_user_units() -> dict:
    unit_dir = HOME / ".config" / "systemd" / "user"
    names = sorted(p.name for p in unit_dir.glob("*.service")) + sorted(p.name for p in unit_dir.glob("*.timer"))
    states = []
    for name in names:
        states.append({
            "unit": name,
            "show": run(["systemctl", "--user", "show", name, "--property=LoadState,ActiveState,SubState,Result,NRestarts,ExecMainStatus,MemoryCurrent,MemoryPeak,CPUUsageNSec,TasksCurrent,FragmentPath", "--no-pager"], timeout=8),
        })
    return {"unit_names": names, "states": states}


def journal_error_counts(since: str) -> dict:
    query = run(["journalctl", "--user", "--since", since, "-p", "err..alert", "--no-pager", "-o", "json"], timeout=15)
    if not query.get("ok"):
        return {"query": query}
    counts: Counter[str] = Counter()
    latest: dict[str, str] = {}
    parse_errors = 0
    for line in query.get("stdout", "").splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            parse_errors += 1
            continue
        unit = row.get("_SYSTEMD_USER_UNIT") or row.get("SYSLOG_IDENTIFIER") or "unknown"
        counts[str(unit)] += 1
        ts = row.get("__REALTIME_TIMESTAMP")
        if ts:
            latest[str(unit)] = str(ts)
    return {"counts_by_unit": dict(counts.most_common()), "latest_timestamp_by_unit": latest, "parse_errors": parse_errors}


def openclaw_automation_health() -> dict:
    result = run(["openclaw", "cron", "list", "--json"], timeout=15, max_output=200000)
    if not result.get("ok"):
        return {"query": result}
    try:
        raw = json.loads(result.get("stdout", "{}"))
    except json.JSONDecodeError:
        return {"error": "invalid-json", "query": result}
    jobs = raw.get("jobs") if isinstance(raw, dict) else raw
    safe = []
    if isinstance(jobs, list):
        for job in jobs:
            if not isinstance(job, dict):
                continue
            state = job.get("state") if isinstance(job.get("state"), dict) else {}
            schedule = job.get("schedule") if isinstance(job.get("schedule"), dict) else {}
            safe.append({
                "id": job.get("id"),
                "name": job.get("name") or job.get("displayName"),
                "agent_id": job.get("agentId"),
                "enabled": job.get("enabled"),
                "schedule": schedule,
                "next_run_at_ms": state.get("nextRunAtMs") or job.get("nextRunAtMs"),
                "last_run_at_ms": state.get("lastRunAtMs"),
                "last_status": state.get("lastStatus") or state.get("lastRunStatus"),
                "last_error": bounded(str(state.get("lastError") or ""), 1000),
            })
    return {"jobs": safe}


def openclaw_plugins() -> dict:
    query = run(["openclaw", "plugins", "list", "--json"], timeout=20, max_output=200000)
    if not query.get("ok"):
        return {"query": query}
    try:
        raw = json.loads(query.get("stdout", "{}"))
    except json.JSONDecodeError:
        return {"error": "invalid-json", "query": query}
    rows = raw.get("plugins", []) if isinstance(raw, dict) else []
    plugins = []
    for item in rows:
        if not isinstance(item, dict):
            continue
        if item.get("enabled") is not True and item.get("status") != "loaded":
            continue
        plugins.append({
            "id": item.get("id"),
            "name": item.get("name"),
            "version": item.get("version"),
            "status": item.get("status"),
            "enabled": item.get("enabled"),
        })
    return {"enabled_plugins": plugins}


def pressure() -> dict:
    result = {}
    for name in ("cpu", "memory", "io"):
        result[name] = read_text(Path("/proc/pressure") / name, 10000)
    return result


def nexus_context() -> dict:
    files = {
        "ai_readme": NEXUS / "AI" / "README.md",
        "engineer": NEXUS / "Areas" / "Personal Computing" / "Engineer Agent.md",
        "personal_vps": NEXUS / "Areas" / "Personal Computing" / "Personal VPS.md",
        "runtime": NEXUS / "AI" / "Runtime Configuration.md",
    }
    return {
        "root": str(NEXUS),
        "head": repo_head_without_git(NEXUS),
        "file_sha256": {key: sha256_file(path) for key, path in files.items()},
        "scheduled_maintenance_contract": extract_markdown_section(files["engineer"], "### Scheduled VPS Maintenance"),
        "vps_resource_baseline": extract_markdown_section(files["personal_vps"], "## Resource Baseline"),
        "vps_recovery_boundary": extract_markdown_section(files["personal_vps"], "## Recovery Boundary"),
        "engineer_runtime_contract": extract_markdown_section(files["runtime"], "### Engineer Agent Runtime"),
    }



def _clip_text(value: object, limit: int = 1200) -> str | None:
    if value is None:
        return None
    text = redact(str(value))
    if len(text) <= limit:
        return text
    return text[:limit] + f"<truncated {len(text) - limit} chars>"


def _clip_items(items: list[object], limit: int = AGENT_LIST_LIMIT) -> dict:
    return {
        "total": len(items),
        "items": items[:limit],
        "truncated": max(0, len(items) - limit),
    }


def _command_brief(value: object, *, stdout_limit: int = 1200, stderr_limit: int = 500) -> dict | None:
    if value is None:
        return None
    if not isinstance(value, dict):
        return {"value": _clip_text(value, stdout_limit)}
    result = {
        key: value.get(key)
        for key in ("available", "exit_code", "ok", "timed_out", "error")
        if key in value
    }
    if value.get("stdout"):
        result["stdout"] = _clip_text(value.get("stdout"), stdout_limit)
    if value.get("stderr"):
        result["stderr"] = _clip_text(value.get("stderr"), stderr_limit)
    return result


def _stdout_json(value: object) -> object | None:
    if not isinstance(value, dict):
        return None
    raw = value.get("stdout")
    if not isinstance(raw, str) or not raw.strip():
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return None


def _apt_upgradable_summary(value: object) -> dict:
    result = {"command": _command_brief(value, stdout_limit=200)}
    stdout = value.get("stdout", "") if isinstance(value, dict) else ""
    packages = []
    for raw in stdout.splitlines():
        line = raw.strip()
        if not line or line == "Listing..." or "/" not in line:
            continue
        packages.append(line.split("/", 1)[0])
    result["packages"] = _clip_items(packages, 30)
    return result


def _simulation_summary(value: object) -> dict:
    stdout = value.get("stdout", "") if isinstance(value, dict) else ""
    summary_lines = []
    for raw in stdout.splitlines():
        line = raw.strip()
        if (
            re.match(r"^\d+ upgraded,", line)
            or line.startswith("The following upgrades have been deferred")
            or line.startswith("The following packages have been kept back")
        ):
            summary_lines.append(line)
    return {
        "command": _command_brief(value, stdout_limit=200),
        "summary_lines": _clip_items(summary_lines, 12),
    }


def _autoremove_summary(value: object) -> dict:
    stdout = value.get("stdout", "") if isinstance(value, dict) else ""
    packages: list[str] = []
    collecting = False
    for raw in stdout.splitlines():
        line = raw.strip()
        if line == "The following packages will be REMOVED:":
            collecting = True
            continue
        if collecting and re.match(r"^\d+ upgraded,", line):
            collecting = False
        if collecting and line and not line.startswith("Remv "):
            packages.extend(line.split())
    return {
        "command": _command_brief(value, stdout_limit=200),
        "packages": _clip_items(packages),
    }


def _version_line(value: object) -> str | None:
    if not isinstance(value, dict):
        return None
    stdout = str(value.get("stdout") or "").strip()
    stderr = str(value.get("stderr") or "").strip()
    text = stdout or stderr
    return text.splitlines()[0] if text else None


def _npm_inventory_summary(value: object) -> dict:
    if not isinstance(value, dict):
        return {"error": "missing"}
    packages = value.get("packages") if isinstance(value.get("packages"), list) else []
    rows = []
    for item in packages:
        if not isinstance(item, dict):
            continue
        installed = item.get("installed")
        latest = item.get("latest")
        registry_ok = item.get("registry_ok")
        if latest != installed or registry_ok is False:
            rows.append({
                "name": item.get("name"),
                "installed": installed,
                "latest": latest,
                "registry_ok": registry_ok,
                "registry_error": _clip_text(item.get("registry_error"), 240),
            })
    return {"total_packages": len(packages), "exceptions": _clip_items(rows)}


def _automation_exceptions(value: object) -> dict:
    jobs = value.get("jobs") if isinstance(value, dict) and isinstance(value.get("jobs"), list) else []
    exceptions = []
    for item in jobs:
        if not isinstance(item, dict):
            continue
        if item.get("enabled") is False or item.get("last_status") not in (None, "ok"):
            exceptions.append(item)
    return {"total_jobs": len(jobs), "exceptions": _clip_items(exceptions)}


def _checkout_summary(value: object) -> dict | None:
    if not isinstance(value, dict):
        return None
    return {
        "path": value.get("path"),
        "head": _command_brief(value.get("head"), stdout_limit=120),
        "origin": _command_brief(value.get("origin"), stdout_limit=300),
        "engineer_source_sha256": value.get("engineer_source_sha256"),
        "deployed_engineer_sha256": value.get("deployed_engineer_sha256"),
    }


def _plugin_summary(value: object) -> dict:
    plugins = value.get("enabled_plugins") if isinstance(value, dict) and isinstance(value.get("enabled_plugins"), list) else []
    versions: Counter[str] = Counter()
    statuses: Counter[str] = Counter()
    for item in plugins:
        if not isinstance(item, dict):
            continue
        versions[str(item.get("version") or "unknown")] += 1
        statuses[str(item.get("status") or "unknown")] += 1
    return {
        "total": len(plugins),
        "versions": dict(versions),
        "statuses": dict(statuses),
    }


def compact_for_agent(snapshot: dict) -> dict:
    official = snapshot.get("official_sources") if isinstance(snapshot.get("official_sources"), dict) else {}
    updates = snapshot.get("updates") if isinstance(snapshot.get("updates"), dict) else {}
    cleanup = snapshot.get("cleanup") if isinstance(snapshot.get("cleanup"), dict) else {}
    capacity = snapshot.get("capacity") if isinstance(snapshot.get("capacity"), dict) else {}
    reliability = snapshot.get("reliability") if isinstance(snapshot.get("reliability"), dict) else {}
    inventory = snapshot.get("inventory") if isinstance(snapshot.get("inventory"), dict) else {}
    config = snapshot.get("configuration_drift") if isinstance(snapshot.get("configuration_drift"), dict) else {}
    recovery = snapshot.get("recovery_readiness") if isinstance(snapshot.get("recovery_readiness"), dict) else {}
    nexus = snapshot.get("nexus") if isinstance(snapshot.get("nexus"), dict) else {}
    versions = snapshot.get("versions") if isinstance(snapshot.get("versions"), dict) else {}

    security = _stdout_json(updates.get("ubuntu_security_status"))
    security_summary = security.get("summary") if isinstance(security, dict) and isinstance(security.get("summary"), dict) else security

    latest_openclaw = official.get("openclaw_latest_stable")
    if isinstance(latest_openclaw, dict):
        latest_openclaw = {
            key: latest_openclaw.get(key)
            for key in ("tag", "name", "published_at", "updated_at")
        }

    node_latest = official.get("node_latest")
    if isinstance(node_latest, dict):
        node_latest = {key: node_latest.get(key) for key in ("version", "date", "lts")}
    node_lts = official.get("node_latest_lts")
    if isinstance(node_lts, dict):
        node_lts = {key: node_lts.get(key) for key in ("version", "date", "lts")}

    result = {
        "schema_version": snapshot.get("schema_version"),
        "collector_version": snapshot.get("collector_version"),
        "mode": snapshot.get("mode"),
        "generated_at_utc": snapshot.get("generated_at_utc"),
        "read_only_contract": snapshot.get("read_only_contract"),
        "agent_output": True,
        "nexus": {
            "head": nexus.get("head"),
            "scheduled_maintenance_contract": _clip_text(nexus.get("scheduled_maintenance_contract"), 4000),
        },
        "sections": {
            "updates": {
                "installed_versions": {key: _version_line(value) for key, value in versions.items()},
                "apt_upgradable": _apt_upgradable_summary(updates.get("apt_upgradable")),
                "apt_upgrade_simulation": _simulation_summary(updates.get("apt_upgrade_simulation")),
                "ubuntu_security_summary": security_summary,
                "latest_openclaw": latest_openclaw,
                "taskctl_compatibility": official.get("taskctl_compatibility"),
                "node_latest": node_latest,
                "node_latest_lts": node_lts,
                "npm_global": _npm_inventory_summary(inventory.get("npm_global")),
            },
            "cleanup": {
                "apt_autoremove": _autoremove_summary(cleanup.get("apt_autoremove_simulation")),
                "apt_cache": cleanup.get("apt_cache"),
                "journal_disk_usage": _command_brief(cleanup.get("journal_disk_usage"), stdout_limit=500),
                "tmp_older_7d": cleanup.get("tmp_older_7d"),
                "var_tmp_older_14d": cleanup.get("var_tmp_older_14d"),
                "known_directory_sizes": _clip_items(
                    cleanup.get("known_directory_sizes") if isinstance(cleanup.get("known_directory_sizes"), list) else [],
                    20,
                ),
                "old_kernel_packages": _command_brief(cleanup.get("old_kernel_packages"), stdout_limit=800),
                "docker_system_df": _command_brief(cleanup.get("docker_system_df"), stdout_limit=400),
                "docker_containers": _command_brief(cleanup.get("docker_containers"), stdout_limit=400),
            },
            "capacity": {
                "cpu_count": capacity.get("cpu_count"),
                "load_1m": capacity.get("load_1m"),
                "load_5m": capacity.get("load_5m"),
                "load_15m": capacity.get("load_15m"),
                "memory": {
                    key: capacity.get("memory", {}).get(key)
                    for key in ("MemTotal", "MemAvailable", "SwapTotal", "SwapFree")
                    if isinstance(capacity.get("memory"), dict)
                },
                "root_filesystem": capacity.get("root_filesystem"),
                "home_filesystem": capacity.get("home_filesystem"),
                "pressure": capacity.get("pressure"),
            },
            "reliability": {
                "failed_user_units": _command_brief(reliability.get("failed_user_units"), stdout_limit=1400),
                "failed_system_units": _command_brief(reliability.get("failed_system_units"), stdout_limit=1400),
                "journal_errors": reliability.get("journal_errors"),
                "kernel_oom": _command_brief(reliability.get("kernel_oom"), stdout_limit=800),
                "openclaw_automation_exceptions": _automation_exceptions(reliability.get("openclaw_automations")),
            },
            "configuration_drift": {
                "implementation_checkout": _checkout_summary(config.get("implementation_checkout")),
                "public_implementation_main": config.get("public_implementation_main"),
                "enabled_plugins": _plugin_summary(snapshot.get("openclaw_plugins")),
                "listening_sockets": _command_brief(inventory.get("listening_sockets"), stdout_limit=650),
            },
            "recovery_readiness": {
                "nexus_sync_unit": _command_brief(recovery.get("nexus_sync_unit"), stdout_limit=700),
                "nexus_sync_timer": _command_brief(recovery.get("nexus_sync_timer"), stdout_limit=700),
                "production_control_unit": _command_brief(recovery.get("production_control_unit"), stdout_limit=700),
                "backup_named_units": recovery.get("backup_named_units"),
                "root_available_bytes": recovery.get("root_available_bytes"),
            },
        },
    }

    result["agent_output_bytes"] = 0
    for _ in range(3):
        encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        result["agent_output_bytes"] = len(encoded)
    encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    result["agent_output_bytes"] = len(encoded)
    if len(encoded) > AGENT_OUTPUT_MAX_BYTES:
        raise RuntimeError(
            f"agent output exceeds limit: {len(encoded)} > {AGENT_OUTPUT_MAX_BYTES} bytes"
        )
    return result



def parse_mode(argv: list[str]) -> str:
    valid = (
        len(argv) == 2
        or (len(argv) == 3 and argv[2] == "--agent-output")
    )
    if not valid or argv[1] not in {"weekly", "monthly"}:
        raise ValueError(
            "usage: engineer-vps-maintenance-snapshot weekly|monthly [--agent-output]"
        )
    return argv[1]


def wants_agent_output(argv: list[str]) -> bool:
    return len(argv) == 3 and argv[2] == "--agent-output"


def collect(mode: str) -> dict:
    generated = datetime.now(timezone.utc).isoformat()
    mem = meminfo()
    cpu_count = os.cpu_count() or 1
    load = os.getloadavg()
    uptime_text = read_text(Path("/proc/uptime"), 256) or "0"
    try:
        uptime_seconds = float(uptime_text.split()[0])
    except (ValueError, IndexError):
        uptime_seconds = None

    versions = {}
    version_commands = {
        "openclaw": ["openclaw", "--version"],
        "node": ["node", "--version"],
        "python": ["python3", "--version"],
        "git": ["git", "--version"],
        "docker": ["docker", "--version"],
        "ffmpeg": ["ffmpeg", "-version"],
    }
    for key, argv in version_commands.items():
        result = run(argv, timeout=8, ok_codes=(0, 1))
        versions[key] = {k: v for k, v in result.items() if k not in {"argv"}}

    apt_upgradable = run(["apt", "list", "--upgradable"], timeout=20, ok_codes=(0, 1))
    apt_sim_upgrade = run(["apt-get", "-s", "upgrade"], timeout=30, ok_codes=(0,))
    security = run(["pro", "security-status", "--format", "json"], timeout=20, ok_codes=(0, 1, 2))

    snapshot = {
        "schema_version": SCHEMA_VERSION,
        "collector_version": COLLECTOR_VERSION,
        "mode": mode,
        "generated_at_utc": generated,
        "read_only_contract": True,
        "nexus": nexus_context(),
        "host": {
            "hostname": socket.gethostname(),
            "kernel": run(["uname", "-a"], timeout=5),
            "os_release": read_text(Path("/etc/os-release"), 10000),
            "uptime_seconds": uptime_seconds,
        },
        "capacity": {
            "cpu_count": cpu_count,
            "load_1m": load[0],
            "load_5m": load[1],
            "load_15m": load[2],
            "memory": mem,
            "root_filesystem": filesystem(Path("/")),
            "home_filesystem": filesystem(HOME),
            "pressure": pressure(),
        },
        "versions": versions,
        "openclaw_plugins": openclaw_plugins(),
        "updates": {
            "apt_upgradable": apt_upgradable,
            "apt_upgrade_simulation": apt_sim_upgrade,
            "ubuntu_security_status": security,
        },
        "reliability": {
            "failed_user_units": run(["systemctl", "--user", "--failed", "--no-legend", "--plain"], timeout=10, ok_codes=(0,)),
            "failed_system_units": run(["systemctl", "--failed", "--no-legend", "--plain"], timeout=10, ok_codes=(0,)),
            "user_units": custom_user_units(),
            "user_timers": run(["systemctl", "--user", "list-timers", "--all", "--no-pager", "--no-legend"], timeout=10),
            "journal_errors": journal_error_counts("7 days ago" if mode == "weekly" else "31 days ago"),
            "kernel_oom": run(["journalctl", "-k", "--since", "7 days ago" if mode == "weekly" else "31 days ago", "--no-pager", "-g", "Out of memory|Killed process|oom-kill"], timeout=15, ok_codes=(0, 1)),
            "openclaw_automations": openclaw_automation_health(),
        },
        "official_sources": official_release_evidence(),
    }

    if mode == "monthly":
        known_dirs = [
            HOME / ".npm",
            HOME / ".cache",
            HOME / ".local" / "share" / "openclaw-production-control",
            HOME / "portfolio-hub",
            HOME / ".openclaw" / "workspace",
            HOME / ".openclaw" / "workspace-tasks",
            HOME / ".openclaw" / "workspace-engineer",
        ]
        snapshot["inventory"] = {
            "apt_manual": run(["apt-mark", "showmanual"], timeout=15),
            "npm_global": global_npm_inventory(),
            "custom_user_units": custom_user_units(),
            "listening_sockets": run(["ss", "-lntup"], timeout=10, ok_codes=(0,)),
        }
        snapshot["cleanup"] = {
            "apt_autoremove_simulation": run(["apt-get", "-s", "autoremove"], timeout=30),
            "apt_cache": dir_stats(Path("/var/cache/apt/archives")),
            "journal_disk_usage": run(["journalctl", "--disk-usage"], timeout=10),
            "tmp_older_7d": dir_stats(Path("/tmp"), 7),
            "var_tmp_older_14d": dir_stats(Path("/var/tmp"), 14),
            "known_directory_sizes": [dir_stats(path) for path in known_dirs if path.exists()],
            "docker_system_df": run(["docker", "system", "df"], timeout=15, ok_codes=(0, 1)),
            "docker_containers": run(["docker", "ps", "-a", "--format", "{{json .}}"], timeout=15, ok_codes=(0, 1)),
            "old_kernel_packages": run(["dpkg-query", "-W", "-f=${Package}\t${Version}\n", "linux-image-*"], timeout=10, ok_codes=(0, 1)),
        }
        implementation = HOME / ".local" / "share" / "openclaw-production-control" / "openclaw-agents"
        snapshot["configuration_drift"] = {
            "implementation_checkout": {
                "path": str(implementation),
                "head": run(["git", "-C", str(implementation), "rev-parse", "HEAD"], timeout=8) if implementation.exists() else None,
                "origin": run(["git", "-C", str(implementation), "remote", "get-url", "origin"], timeout=8) if implementation.exists() else None,
                "engineer_source_sha256": sha256_file(implementation / "agents" / "engineer" / "workspace" / "AGENTS.md") if implementation.exists() else None,
                "deployed_engineer_sha256": sha256_file(HOME / ".openclaw" / "workspace-engineer" / "AGENTS.md"),
            },
            "public_implementation_main": snapshot["official_sources"].get("openclaw_agents_src_main"),
        }
        snapshot["recovery_readiness"] = {
            "nexus_sync_unit": run(["systemctl", "--user", "show", "nexus-sync.service", "--property=ActiveState,SubState,Result,NRestarts,ExecMainStatus", "--no-pager"], timeout=8),
            "nexus_sync_timer": run(["systemctl", "--user", "show", "nexus-sync.timer", "--property=ActiveState,SubState,LastTriggerUSec,NextElapseUSecRealtime", "--no-pager"], timeout=8),
            "production_control_unit": run(["systemctl", "--user", "show", "openclaw-task-production-control.service", "--property=ActiveState,SubState,Result,NRestarts,ExecMainStatus", "--no-pager"], timeout=8),
            "backup_named_units": sorted(p.name for p in (HOME / ".config" / "systemd" / "user").glob("*backup*")),
            "root_available_bytes": snapshot["capacity"]["root_filesystem"].get("bytes_available"),
        }
    return snapshot


def main(argv: list[str]) -> int:
    try:
        mode = parse_mode(argv)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    try:
        result = collect(mode)
        if wants_agent_output(argv):
            result = compact_for_agent(result)
    except Exception as exc:
        print(json.dumps({"schema_version": SCHEMA_VERSION, "mode": mode, "fatal_error": f"{type(exc).__name__}: {exc}"}, ensure_ascii=False))
        return 1
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
