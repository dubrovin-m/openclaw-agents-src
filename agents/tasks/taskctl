function ensureLegacySelf(db, at=now()) {
  const rows=db.prepare('SELECT id FROM people WHERE display_name=? ORDER BY id').all(SELF_NAME);
  if(rows.length>1) throw new AppError('INTEGRITY_ERROR','Multiple canonical self Person rows exist');
  if(rows.length===1) return rows[0].id;
  return Number(db.prepare('INSERT INTO people(display_name,created_at) VALUES(?,?)').run(SELF_NAME,at).lastInsertRowid);
}
