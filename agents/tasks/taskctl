  const rendered=reminderRenderClaim(db,{claim_token:claimToken});
  if(rendered.count===0)return{ok:true,count:0,delivered:0,suppressed:claimed.count};
  const route=reminderDeliveryRoute(),args=['message','send','--channel',route.channel,'--account',route.account,'--target',route.target,'--message',rendered.message,'--json'];
