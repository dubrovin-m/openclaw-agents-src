[Unit]
Description=Task Agent independent recovery backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/nexus-recovery/task-backup.env
ExecStart=%h/.local/lib/nexus-recovery/task-independent-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
