{
  "name": "openclaw-plugin-calendar-analytics",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/plugin.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --root . --entry ./dist/plugin.js",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "dependencies": {
    "google-auth-library": "^10.3.0",
    "typebox": "1.3.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  }
}
